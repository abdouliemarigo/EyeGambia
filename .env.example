# Server-side only. Never expose this key to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Supabase will be connected in the final backend phase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional production controls
EYEGAMBIA_SANDBOX_ENABLED=false
EYEGAMBIA_SANDBOX_DOCKER=false

# Pro billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional distributed rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional monitoring
SENTRY_DSN=
DEPLOY_PROVIDER=
STRIPE_WEBHOOK_SECRET=

# Monitoring dashboard/API access (keep secret)
EYEGAMBIA_METRICS_TOKEN=

# Optional distributed monitoring + rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
